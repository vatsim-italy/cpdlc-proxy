# Copy to .env and fill in. Never commit .env.
# The proxy's own Hoppie logon code (used for everything sent as the FIR station).
HOPPIE_LOGON=
# Public host name routed by Traefik to the proxy.
CPDLC_PROXY_HOST=cpdlc.example.org
# Existing Docker network Traefik is attached to.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Image tag from ghcr.io/vatsim-italy/cpdlc-proxy: latest (main), a branch name, or sha-<short>.
CPDLC_PROXY_TAG=latest
